# SwapDeck's live backend. See .env.example for what this points at and why.
VITE_API_BASE_URL=https://swapdeck-api.cwinchester636.workers.dev

# Public VAPID key for browser push (see worker/src/push.js and README "Push
# notifications"). This is the public half of a keypair -- safe to commit,
# it's handed to every subscribing browser. Must match VAPID_PUBLIC_KEY in
# worker/wrangler.toml exactly, or subscribing will fail.
VITE_VAPID_PUBLIC_KEY=BLw28wJ4CUrHRBlSUzP14zNOrpWO6YCp38c3gJySxD1XppklHWqNeeWDWe36QvpHmkmmd3wDvbpjqIai7qofLZ0

# RevenueCat's public SDK key (Android), for the native Pro purchase flow
# (see src/utils/purchases.js, worker/src/routes/purchases.js, and README
# "In-app purchases"). Public, not secret -- same reasoning as the VAPID
# public key above, it's handed to every install of the native app. Left
# blank until a RevenueCat project exists to get a real value from;
# purchasing is simply unavailable (not broken) while this is empty --
# see isPurchasingSupported() in src/utils/purchases.js.
VITE_REVENUECAT_PUBLIC_KEY=
