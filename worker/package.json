{
  "name": "swapdeck-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config ./wrangler.toml",
    "migrate:local": "wrangler d1 migrations apply swapdeck --local --config ./wrangler.toml",
    "migrate:remote": "wrangler d1 migrations apply swapdeck --remote --config ./wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0"
  }
}
